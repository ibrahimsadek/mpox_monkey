  --eval_on_original_only ^
  --split_strategy group_stratified ^
  --group_mode regex ^
  --group_regex "^(?:v[0-9]+__)?(.+?)(?:_(?:ORIGINAL|[0-9]+))?$" ^
  --cv_folds 5 ^
