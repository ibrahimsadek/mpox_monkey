  --ensemble_weight_trials 4096 ^
  --ensemble_weight_seed 42 ^
  --early_stop_patience 4 ^
  --early_stop_metric f1_at_precision ^
  --threshold_strategy f1_at_precision ^
  --precision_target 0.80 ^
  --moo_plot ^
  --rag_enable ^
  --rag_model auto ^
  --rag_index_source train_orig_only ^
  --rag_k 25 ^
  --rag_alpha 0.25 ^
  --rag_metric cosine ^
  --rag_weighted ^
  --rag_temp 0.07 ^
  --rag_chunk 512 ^
  --rag_tta 0 ^
  --plot_dpi 600
