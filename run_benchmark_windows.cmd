  --models "efficientnetv2_s,convnext_tiny,vit_b_16,resnet50,densenet121,efficientnet_b0,mobilenet_v3_large" ^
  --img_size 224 ^
  --pretrained ^
  --amp ^
  --tta 16 ^
  --use_weighted_sampler ^
  --train_mix original+aug ^
  --train_orig_ratio 0.7 ^
